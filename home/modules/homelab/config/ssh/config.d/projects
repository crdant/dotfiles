Match exec "uname -s | grep -q Darwin" host *.mash
  RemoteCommand source ~/.zshrc && cd ~/workspace/$(basename %n .mash) && smug-session window
  RequestTTY Yes
  HostName mash
  CanonicalizeHostName yes
  CanonicalDomains lab.shortrib.net shortrib.sh
  StreamLocalBindUnlink yes
  RemoteForward /run/user/1001/gnupg/S.gpg-agent /private/var/run/org.nix-community.home.gpg-agent/S.gpg-agent.extra
  RemoteForward /run/user/1001/gnupg/S.gpg-agent.ssh /private/var/run/org.nix-community.home.gpg-agent/S.gpg-agent.ssh

Match exec "uname -s | grep -q Darwin" host *.pisco
  RemoteCommand source ~/.zshrc && cd ~/workspace/$(basename %n .pisco) && smug-session window
  RequestTTY Yes
  HostName pisco
  CanonicalizeHostName yes
  CanonicalDomains lab.shortrib.net shortrib.sh
  StreamLocalBindUnlink yes
  RemoteForward /Users/crdant/.gnupg/S.gpg-agent /private/var/run/org.nix-community.home.gpg-agent/S.gpg-agent
  RemoteForward /Users/crdant/.gnupg/S.gpg-agent.ssh /private/var/run/org.nix-community.home.gpg-agent/S.gpg-agent.ssh

  CanonicalizeHostName yes
  CanonicalDomains lab.shortrib.net shortrib.sh
  StreamLocalBindUnlink yes
  RemoteForward /run/user/1001/gnupg/S.gpg-agent /private/var/run/org.nix-community.home.gpg-agent/S.gpg-agent
  RemoteForward /run/user/1001/gnupg/S.gpg-agent.ssh /private/var/run/org.nix-community.home.gpg-agent/S.gpg-agent.ssh

